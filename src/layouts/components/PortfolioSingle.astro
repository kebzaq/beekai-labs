---
import { ready } from "@/lib/utils/todo";
import { render, type CollectionEntry } from "astro:content";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { markdownify } from "@/lib/utils/textConverter";
import { getLocaleUrlCTM, useTranslations } from "@/lib/utils/i18nUtils";
import {
  getIndustries,
  getPortfolioCategories,
  getServices,
} from "@/lib/utils/siteData";
import CustomButton from "./CustomButton.astro";
import PageHeader from "./widgets/PageHeader.astro";
import OptimizedImage from "./utilities/OptimizedImage.astro";
import PaginationForSingle from "./widgets/PaginationForSingle.astro";

type Props = {
  content: CollectionEntry<"portfolio">;
};

const { content } = Astro.props;
const { collection, data } = content;

const t = await useTranslations(Astro.currentLocale as string);
const { Content } = await render(content);

const categoryTitles = (await getPortfolioCategories())
  .filter((category) => data.categories.includes(category.id))
  .map((category) => category.data.title);

const industry = (await getIndustries()).find(
  (item) => item.id === data.industry,
);

const services = (await getServices()).filter((service) =>
  data.services.includes(service.id),
);

const statusClass = {
  Live: "status-badge-live",
  Concept: "status-badge-concept",
  "In progress": "",
}[data.status];

// Placeholder text ("[TODO: ...]") is shown while developing and left out of the live site
const client = ready(data.client);
// Screenshots are shown only when the files are really there
const screenshotFiles = import.meta.glob(
  "/src/assets/{images,work}/**/*.{png,jpg,jpeg,webp}",
);
const hasFile = (path?: string) =>
  !!path && !!screenshotFiles[`/src/assets/${path.replace(/^\/+/, "")}`];
const desktopScreenshot = hasFile(data.coverImage) ? data.coverImage : undefined;
const mobileScreenshot = hasFile(data.mobileImage) ? data.mobileImage : undefined;

// The card's photo cover (laptop + phone), shown large under the header.
// Without the file, the page keeps the screenshots in the browser and phone frames below.
const coverFiles = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/{work,images}/**/*.{png,jpg,jpeg,webp}",
);
const coverPath = data.cover && `/src/assets/${data.cover.replace(/^\/+/, "")}`;
const coverImage =
  coverPath && coverFiles[coverPath]
    ? (await coverFiles[coverPath]()).default
    : undefined;
// Same alt as the card's cover
const coverAlt = data.coverAlt || `${data.title} ${t("common.coverAltSuffix")}`;

const details = [
  { label: t("common.challengeTitle"), value: ready(data.challenge) },
  { label: t("common.solutionTitle"), value: ready(data.solution) },
  { label: t("common.resultsTitle"), value: ready(data.results) },
].filter((item) => item.value);
---

<PageHeader
  eyebrow={categoryTitles.join(" · ")}
  title={data.title}
  description={ready(data.summary)}>
  {
    data.liveUrl && (
      <CustomButton
        label={t("common.viewLiveSite")}
        url={data.liveUrl}
        hoverEffect="creative-fill"
        class="btn-accent effect-color-light"
      />
    )
  }
</PageHeader>

{
  coverImage ? (
    <section>
      <div class="container">
        {/* Natural aspect ratio, so the laptop and phone are never cropped.
            Full width on mobile, about 90% on tablet, up to 896px (max-w-4xl) on desktop */}
        <Image
          src={coverImage}
          alt={coverAlt}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1024px) 896px, (min-width: 768px) 660px, calc(100vw - 32px)"
          loading="eager"
          fetchpriority="high"
          class="mx-auto h-auto w-full rounded-xl shadow-lg md:w-11/12 lg:max-w-4xl"
        />
      </div>
    </section>
  ) : desktopScreenshot && (
    <section>
      <div class="container">
        <div class="bg-theme-darker flex flex-col items-end justify-center gap-8 p-6 md:flex-row md:p-10">
          <div class="w-full border border-white/15 md:w-3/4">
            <div
              class="flex gap-1.5 bg-white/10 px-3 py-2.5"
              aria-hidden="true">
              <span class="size-2 rounded-full bg-white/40" />
              <span class="size-2 rounded-full bg-white/40" />
              <span class="size-2 rounded-full bg-white/40" />
            </div>
            <OptimizedImage
              src={desktopScreenshot}
              alt={`${t("common.desktopScreenshot")} ${data.title}`}
              width={1440}
              height={900}
              loading="eager"
              class="w-full"
            />
          </div>
          {mobileScreenshot && (
            <div class="w-1/2 border-4 border-white/15 md:w-1/5">
              <OptimizedImage
                src={mobileScreenshot}
                alt={`${t("common.mobileScreenshot")} ${data.title}`}
                width={390}
                height={844}
                loading="lazy"
                class="w-full"
              />
            </div>
          )}
        </div>
      </div>
    </section>
  )
}

<section>
  <div class="container">
    <div class="grid grid-cols-1 gap-x-20 gap-y-12 lg:grid-cols-3">
      <dl class="bg-theme-light h-fit space-y-5 p-8">
        {
          client && (
            <div>
              <dt class="text-sm opacity-80">{t("common.clientLabel")}</dt>
              <dd class="font-secondary text-dark font-semibold">{client}</dd>
            </div>
          )
        }
        {
          data.location && (
            <div>
              <dt class="text-sm opacity-80">{t("common.locationLabel")}</dt>
              <dd class="font-secondary text-dark font-semibold">
                {data.location}
              </dd>
            </div>
          )
        }
        {
          industry && (
            <div>
              <dt class="text-sm opacity-80">{t("common.industryLabel")}</dt>
              <dd class="font-secondary text-dark font-semibold">
                <a
                  class="hover:text-accent-hover underline underline-offset-4"
                  href={getLocaleUrlCTM(
                    `/industries/${industry.id}/`,
                    Astro.currentLocale,
                  )}>
                  {industry.data.title}
                </a>
              </dd>
            </div>
          )
        }
        {
          services.length > 0 && (
            <div>
              <dt class="text-sm opacity-80">{t("common.servicesLabel")}</dt>
              {services.map((service) => (
                <dd class="font-secondary text-dark font-semibold">
                  {service.data.status === "available" ? (
                    <a
                      class="hover:text-accent-hover underline underline-offset-4"
                      href={getLocaleUrlCTM(
                        `/services/${service.id}/`,
                        Astro.currentLocale,
                      )}>
                      {service.data.title}
                    </a>
                  ) : (
                    service.data.title
                  )}
                </dd>
              ))}
            </div>
          )
        }
        <div>
          <dt class="mb-1 text-sm opacity-80">{t("common.statusLabel")}</dt>
          <dd>
            <span class:list={["status-badge", statusClass]}>
              {data.status}
            </span>
          </dd>
        </div>
      </dl>

      <div class="space-y-10 lg:col-span-2">
        {
          details.map((item) => (
            <div class="space-y-3">
              <h2 class="text-h4-sm md:text-h4">{item.label}</h2>
              {/* Markdown with blank lines between paragraphs renders as separate paragraphs */}
              <div
                class="space-y-4 text-lg"
                set:html={markdownify(item.value as string, true)}
              />
            </div>
          ))
        }
        {
          content.body?.trim() && (
            <div class="prose-styles">
              <Content />
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

{
  data.gallery.length > 0 && (
    <section>
      <div class="container space-y-8">
        <h2 class="section-title text-h3-sm md:text-h3">
          {t("common.galleryTitle")}
        </h2>
        <ul class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {data.gallery.map((image, index) => (
            <li>
              <OptimizedImage
                src={image}
                alt={`${data.title}, image ${index + 1}`}
                loading="lazy"
                class="w-full"
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<section>
  <div class="container">
    <div class="border-border-light border-t pt-10">
      <PaginationForSingle
        prevBtnText={t("common.paginationPortfolioPrev")}
        nextBtnText={t("common.paginationPortfolioNext")}
        currentPage={content}
        collection={collection}
      />
    </div>
  </div>
</section>
