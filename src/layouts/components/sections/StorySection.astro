---
import type { z } from "astro/zod";
import { getSectionContent } from "@/lib/contentParser.astro";
import type { storySectionSchema } from "@/sections.schema";
import SectionHeader from "@/components/widgets/SectionHeader.astro";

type StoryContent = NonNullable<z.infer<typeof storySectionSchema>>;

type Props = {
  content?: StoryContent;
};

const {
  enable = true,
  title,
  description,
  nameParts = [],
  nameResult,
} = await getSectionContent<StoryContent>(
  "story-section",
  Astro.props.content,
  Astro.currentLocale,
);

if (!enable) {
  return null;
}

// Honeycomb geometry (SVG user units): pointy-top hexagons on a shared grid
const cellRadius = 60;
const cellWidth = Math.sqrt(3) * cellRadius;
const hexPoints = (cx: number, cy: number, radius = cellRadius - 4) =>
  Array.from({ length: 6 }, (_, i) => {
    const angle = (Math.PI / 3) * i - Math.PI / 2;
    return `${(cx + radius * Math.cos(angle)).toFixed(1)},${(cy + radius * Math.sin(angle)).toFixed(1)}`;
  }).join(" ");

// Top row: one cell per name part. Bottom row: the combined name, centered below.
const parts = nameParts.slice(0, 2).map((part, i) => ({
  ...part,
  cx: cellWidth / 2 + i * cellWidth,
  cy: cellRadius,
}));
const result = { cx: cellWidth, cy: cellRadius * 2.5 };
const showVisual = parts.length === 2 && !!nameResult;
const visualLabel = `${parts.map((part) => part.label).join(" + ")} = ${nameResult}`;
---

<section id="story">
  <div class="container">
    <div
      class="grid grid-cols-1 items-center gap-x-20 gap-y-12 lg:grid-cols-2">
      <SectionHeader title={title} description={description} align="left" />
      {
        showVisual && (
          <svg
            viewBox={`0 0 ${(cellWidth * 2).toFixed(1)} ${cellRadius * 3.5}`}
            class="font-secondary mx-auto w-full max-w-xs font-bold md:max-w-sm"
            role="img"
            aria-label={visualLabel}>
            {parts.map((part) => (
              <g>
                <polygon
                  points={hexPoints(part.cx, part.cy)}
                  class="fill-accent-soft stroke-accent stroke-2"
                />
                <text
                  x={part.cx}
                  y={part.note ? part.cy : part.cy + 8}
                  text-anchor="middle"
                  class="fill-dark text-2xl">
                  {part.label}
                </text>
                {part.note && (
                  <text
                    x={part.cx}
                    y={part.cy + 20}
                    text-anchor="middle"
                    class="fill-text-default text-xs font-normal">
                    {part.note}
                  </text>
                )}
              </g>
            ))}
            <polygon
              points={hexPoints(result.cx, result.cy)}
              class="fill-accent"
            />
            <text
              x={result.cx}
              y={result.cy + 7}
              text-anchor="middle"
              class="fill-dark text-xl">
              {nameResult}
            </text>
          </svg>
        )
      }
    </div>
  </div>
</section>
