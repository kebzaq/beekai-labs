---
import type { z } from "astro/zod";
import { getSectionContent } from "@/lib/contentParser.astro";
import { getWhyUsItems } from "@/lib/utils/siteData";
import type { whyUsSectionSchema } from "@/sections.schema";
import FeatureCard from "@/components/cards/FeatureCard.astro";
import SectionHeader from "@/components/widgets/SectionHeader.astro";
import FounderCard from "@/components/widgets/FounderCard.astro";

type WhyUsContent = NonNullable<z.infer<typeof whyUsSectionSchema>>;

type Props = {
  content?: WhyUsContent;
};

const {
  enable = true,
  eyebrow,
  title,
  description,
  limit,
  founder,
} = await getSectionContent<WhyUsContent>(
  "why-us-section",
  Astro.props.content,
  Astro.currentLocale,
);

// Items come from src/content/data/why-us.yml, in `order`. `limit` keeps the first few.
const allItems = await getWhyUsItems();
const items = limit ? allItems.slice(0, limit) : allItems;

if (!enable) {
  return null;
}
---

<section id="why-us">
  <div class="bg-theme-darker relative overflow-hidden py-20 md:py-32">
    <div class="accent-glow -top-72" aria-hidden="true"></div>
    <div
      class="relative container grid grid-cols-1 gap-x-16 gap-y-12 lg:grid-cols-5">
      <div class="space-y-10 lg:col-span-2">
        <SectionHeader
          eyebrow={eyebrow}
          title={title}
          description={description}
          appearance="dark"
          align="left"
        />
        {founder?.enable !== false && founder?.text && <FounderCard {...founder} />}
      </div>
      <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:col-span-3">
        {
          items.map((item) => (
            <li data-reveal>
              <FeatureCard
                appearance="dark"
                icon={item.data.icon}
                title={item.data.title}
                description={item.data.description}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
