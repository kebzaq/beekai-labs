---
import type { z } from "astro/zod";
import { getSectionContent } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import type { aboutSectionSchema } from "@/sections.schema";
import SectionHeader from "@/components/widgets/SectionHeader.astro";

type AboutContent = NonNullable<z.infer<typeof aboutSectionSchema>>;

type Props = {
  content?: AboutContent;
};

const {
  enable = true,
  title,
  description,
  mission,
} = await getSectionContent<AboutContent>(
  "about-section",
  Astro.props.content,
  Astro.currentLocale,
);

if (!enable) {
  return null;
}
---

<section id="about">
  <div class="container space-y-14">
    <SectionHeader title={title} description={description} />
    {
      mission?.description && (
        <div class="bg-theme-darker text-light border-accent mx-auto max-w-4xl space-y-5 border-s-4 p-8 md:p-12">
          {mission.title && (
            <h2 class="text-h4-sm md:text-h4 text-accent">{mission.title}</h2>
          )}
          <p
            class="text-xl md:text-2xl"
            set:html={markdownify(mission.description)}
          />
          {mission.tagline && (
            <p class="font-secondary text-accent-light text-sm uppercase">
              {mission.tagline}
            </p>
          )}
        </div>
      )
    }
  </div>
</section>
