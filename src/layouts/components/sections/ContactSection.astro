---
import type { z } from "astro/zod";
import config from ".astro/config.generated.json";
import Icons from "@/helpers/Icons.astro";
import { getSectionContent } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { useTranslations } from "@/lib/utils/i18nUtils";
import type { contactSectionSchema } from "@/sections.schema";
import ContactForm from "@/components/widgets/ContactForm.astro";
import SectionHeader from "@/components/widgets/SectionHeader.astro";

type ContactContent = NonNullable<z.infer<typeof contactSectionSchema>>;

type Props = {
  content?: ContactContent;
};

const {
  enable = true,
  title,
  description,
  note,
  form,
} = await getSectionContent<ContactContent>(
  "contact-section",
  Astro.props.content,
  Astro.currentLocale,
);

const t = await useTranslations(Astro.currentLocale as string);
const { email, phone, serviceArea } = config.settings.contactInfo;

const contactDetails = [
  { icon: "Mail", label: t("common.emailLabel"), value: email },
  { icon: "Phone", label: t("common.phoneLabel"), value: phone },
  { icon: "MapPin", label: t("common.serviceAreaLabel"), value: serviceArea },
].filter((item) => item.value);

if (!enable) {
  return null;
}
---

<section id="contact">
  <div class="container">
    <div class="grid grid-cols-1 gap-x-20 gap-y-12 lg:grid-cols-2">
      <div class="space-y-8">
        <SectionHeader title={title} description={description} align="left" />
        {
          note && (
            <div class="font-secondary text-dark flex items-center gap-3 font-medium">
              <Icons
                icon="Clock"
                class="text-accent-hover size-5 shrink-0"
                aria-hidden="true"
              />
              <p>{note}</p>
            </div>
          )
        }
        <ul class="prose-a:hover:text-accent-hover space-y-3">
          {
            contactDetails.map((item) => (
              <li class="flex items-start gap-3">
                <Icons
                  icon={item.icon as any}
                  class="text-accent-hover mt-1 size-5 shrink-0"
                  aria-hidden="true"
                />
                <span class="sr-only">{item.label}: </span>
                <span set:html={markdownify(item.value)} />
              </li>
            ))
          }
        </ul>
      </div>
      {form && <ContactForm form={form} />}
    </div>
  </div>
</section>
