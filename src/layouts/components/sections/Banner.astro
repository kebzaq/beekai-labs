---
import type { z } from "astro/zod";
import { getSectionContent } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import CustomButton from "@/components/CustomButton.astro";
import type { bannerAgencySectionSchema } from "@/sections.schema";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";

// Type for this section data
type BannerContent = NonNullable<z.infer<typeof bannerAgencySectionSchema>>;

type Props = {
  content?: BannerContent;
};

// Default content from banner.md, with optional page-specific overrides
const {
  enable = true,
  title,
  image,
  titleSize,
  description,
  button,
  secondaryButton,
  note,
} = await getSectionContent<BannerContent>(
  "banner",
  Astro.props.content,
  Astro.currentLocale,
);

// Font sizes for the heading (useful if you have a long heading)
const fontSizeMap: Record<NonNullable<typeof titleSize>, string> = {
  "display-1": "text-display-3 lg:text-display-2 xl:text-display-1",
  "display-2": "text-display-5 md:text-display-3 xl:text-display-2",
  "display-3": "text-display-6 md:text-display-5 xl:text-display-4",
};

const fontSize = titleSize ? fontSizeMap[titleSize] : fontSizeMap["display-1"];

if (!enable) {
  return null;
}
---

<section
  class:list={[
    "text-light relative overflow-hidden bg-black pt-44 md:pt-52",
    image ? "mb-24 md:mb-32" : "pb-24 md:pb-32",
  ]}>
  <div class="accent-glow -bottom-72" aria-hidden="true"></div>
  <div class="relative container">
    <div class="mx-auto max-w-5xl space-y-7 text-center md:space-y-10">
      {
        title && (
          <h1
            data-aos="reveal-anim-top"
            data-aos-duration="1500"
            class:list={[fontSize, "font-bold text-inherit"]}
            set:html={markdownify(title)}
          />
        )
      }
      <div
        data-aos="reveal-anim-top"
        data-aos-duration="1500"
        data-aos-delay="200"
        class="mx-auto max-w-2xl space-y-8">
        {
          description && (
            <p
              class="text-lg text-inherit opacity-80"
              set:html={markdownify(description)}
            />
          )
        }
        {
          (button?.enable || secondaryButton?.enable) && (
            <div class="flex flex-wrap items-center justify-center gap-4">
              {button?.enable && (
                <CustomButton
                  hoverEffect="creative-fill"
                  class="btn-accent effect-color-light"
                  {...button}
                />
              )}
              {secondaryButton?.enable && (
                <CustomButton
                  hoverEffect="creative-fill"
                  class="btn-outline-light effect-color-accent"
                  {...secondaryButton}
                />
              )}
            </div>
          )
        }
        {note && <p class="text-sm opacity-70" set:html={markdownify(note)} />}
      </div>

      {
        image && (
          <div
            data-aos="reveal-anim-top"
            data-aos-duration="1500"
            data-aos-delay="300"
            data-aos-offset="0"
            class="mx-auto mt-10 -mb-24 max-w-4xl md:mt-20 md:-mb-32">
            <OptimizedImage
              src={image}
              alt=""
              loading="eager"
              class="h-110 w-full object-cover md:h-135"
            />
          </div>
        )
      }
    </div>
  </div>
</section>
