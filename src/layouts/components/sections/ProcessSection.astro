---
import type { z } from "astro/zod";
import { getSectionContent } from "@/lib/contentParser.astro";
import { getProcessSteps } from "@/lib/utils/siteData";
import type { processSectionSchema } from "@/sections.schema";
import SectionHeader from "@/components/widgets/SectionHeader.astro";

type ProcessContent = NonNullable<z.infer<typeof processSectionSchema>>;

type Props = {
  content?: ProcessContent;
};

const {
  enable = true,
  title,
  description,
} = await getSectionContent<ProcessContent>(
  "process-section",
  Astro.props.content,
  Astro.currentLocale,
);

// Steps come from src/content/data/process.yml
const steps = await getProcessSteps();

if (!enable) {
  return null;
}
---

<section id="process">
  <div class="bg-theme-darker text-light py-20 md:py-32">
    <div class="container space-y-14">
      <SectionHeader
        title={title}
        description={description}
        appearance="dark"
      />
      <ol class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-5">
        {
          steps.map((step, index) => (
            <li class="space-y-3 border-t border-white/15 pt-6">
              <span
                class="font-secondary text-accent text-h4 block font-bold"
                aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3 class="text-h6 text-light">{step.data.title}</h3>
              <p class="opacity-80">{step.data.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
