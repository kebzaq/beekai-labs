---
import type { ImageMetadata } from "astro";
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Icons from "@/helpers/Icons.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { getIndustries } from "@/lib/utils/siteData";
import { getLocaleUrlCTM, useTranslations } from "@/lib/utils/i18nUtils";
import { ready } from "@/lib/utils/todo";
import DeviceMockup from "@/components/widgets/DeviceMockup.astro";

type Props = {
  content: CollectionEntry<"portfolio">;
  headingTag?: "h3" | "h4";
  featured?: boolean; // Larger card with a bigger device mockup
  class?: string;
};

const {
  content,
  headingTag: Heading = "h3",
  featured = false,
  class: className,
} = Astro.props;
const { id, collection, data } = content;

const t = await useTranslations(Astro.currentLocale as string);
const slug = getLocaleUrlCTM(
  data.customSlug || id,
  Astro.currentLocale,
  collection,
);

const industry = (await getIndustries()).find(
  (item) => item.id === data.industry,
);

// Client and industry line (the client is skipped when it repeats the title
// or is still a placeholder on the live site)
const client = ready(data.client);
const meta = [client !== data.title && client, industry?.data.title]
  .filter(Boolean)
  .join(" · ");

// Website projects show a screenshot in a browser frame, other projects an icon
const isWebsite = data.categories.includes("websites");

// Screenshots for the device mockup, used only when the file is really there
const screenshotFiles = import.meta.glob(
  "/src/assets/{images,work}/**/*.{png,jpg,jpeg,webp}",
);
const hasFile = (path?: string) =>
  !!path && !!screenshotFiles[`/src/assets/${path.replace(/^\/+/, "")}`];
const hasScreenshots = isWebsite && hasFile(data.coverImage);
const mobileScreenshot = hasFile(data.mobileImage) ? data.mobileImage : undefined;

// Photo cover (src/assets/work/<project>/cover.* or any image in src/assets/images).
// Without the file, website cards keep the device mockup.
const coverFiles = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/{work,images}/**/*.{png,jpg,jpeg,webp}",
);
const coverPath = data.cover && `/src/assets/${data.cover.replace(/^\/+/, "")}`;
const coverImage =
  coverPath && coverFiles[coverPath]
    ? (await coverFiles[coverPath]()).default
    : undefined;

// Problem / solution / result lines, without placeholders on the live site
const details = [
  { label: t("common.problemLabel"), value: ready(data.challenge) },
  { label: t("common.solutionLabel"), value: ready(data.solution) },
  { label: t("common.resultLabel"), value: ready(data.results) },
].filter((item) => item.value);
const summary = ready(data.summary);

const statusClass = {
  Live: "status-badge-live",
  Concept: "status-badge-concept",
  "In progress": "",
}[data.status];

const linkClass =
  "font-secondary text-dark hover:text-accent-hover inline-flex items-center gap-2 text-sm uppercase";
---

<article
  data-filter-item
  data-categories={data.categories.join(" ")}
  class:list={[
    "group card-soft flex h-full flex-col",
    featured && "lg:flex-row",
    className,
  ]}>
  {
    coverImage ? (
      <div
        class:list={[
          "bg-theme-darker aspect-video overflow-hidden",
          featured && "lg:aspect-auto lg:w-3/5 lg:shrink-0",
        ]}>
        <Image
          src={coverImage}
          alt={data.coverAlt || `${data.title} ${t("common.coverAltSuffix")}`}
          widths={[480, 720, 960, 1280]}
          sizes={
            featured
              ? "(min-width: 1024px) 60vw, (min-width: 768px) 90vw, 100vw"
              : "(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
          }
          loading="lazy"
          class="size-full object-cover object-center transition duration-500 group-hover:scale-105 motion-reduce:transition-none"
          style={data.coverPosition ? `object-position: ${data.coverPosition}` : undefined}
        />
      </div>
    ) : hasScreenshots ? (
      <div
        class:list={[
          "bg-theme-darker relative flex aspect-video items-center justify-center overflow-hidden px-14 pb-4 sm:px-16",
          featured && "lg:aspect-auto lg:w-3/5 lg:shrink-0 lg:px-12 lg:py-12",
        ]}>
        <div class="accent-glow -bottom-80" aria-hidden="true" />
        <DeviceMockup
          desktop={data.coverImage as string}
          mobile={mobileScreenshot}
          desktopAlt={`${t("common.desktopScreenshot")} ${data.title}`}
          mobileAlt={`${t("common.mobileScreenshot")} ${data.title}`}
          size={featured ? "large" : "default"}
          class="relative w-full"
        />
      </div>
    ) : (
      <div class="bg-theme-darker relative flex aspect-video items-center justify-center overflow-hidden">
        <div class="accent-glow -bottom-80" aria-hidden="true" />
        <Icons
          icon={(data.icon || "Sparkles") as any}
          class="text-accent relative size-16 transition duration-500 group-hover:scale-110 motion-reduce:transition-none"
          aria-hidden="true"
        />
      </div>
    )
  }

  <div
    class:list={[
      "flex grow flex-col gap-4",
      featured ? "p-6 md:p-8 lg:justify-center lg:p-10" : "p-6",
    ]}>
    <div class="flex flex-wrap items-center justify-between gap-2">
      {meta && <p class="text-sm opacity-80">{meta}</p>}
      <span class:list={["status-badge", statusClass]}>{data.status}</span>
    </div>

    <Heading class={featured ? "text-h4-sm md:text-h4" : "text-h5"}>
      <a href={slug} class="hover:text-accent-hover">{data.title}</a>
    </Heading>

    {/* Website projects and projects with a photo cover show the summary,
        other projects their problem / solution / result lines */}
    {
      isWebsite || coverImage ? (
        summary && (
          <p
            class:list={[featured && "text-lg"]}
            set:html={markdownify(summary)}
          />
        )
      ) : (
        <dl class="space-y-3">
          {details.map((item) => (
            <div>
              <dt class="font-secondary text-dark text-sm font-semibold">
                {item.label}
              </dt>
              <dd set:html={markdownify(item.value as string)} />
            </div>
          ))}
        </dl>
      )
    }

    <div
      class:list={[
        "flex flex-wrap gap-x-6 gap-y-2 pt-2",
        !featured && "mt-auto",
      ]}>
      <a href={slug} class={linkClass}>
        {t("common.viewCaseStudy")}
        <span class="sr-only">: {data.title}</span>
        <Icons icon="ArrowRight" class="size-4" aria-hidden="true" />
      </a>
      {
        data.liveUrl && (
          <a
            href={data.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={linkClass}>
            {t("common.visitWebsite")}
            <span class="sr-only">
              : {data.title} ({t("common.opensInNewTab")})
            </span>
            <Icons icon="ArrowUpRight" class="size-4" aria-hidden="true" />
          </a>
        )
      }
    </div>
  </div>
</article>
