---
import { markdownify } from "@/lib/utils/textConverter";

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  appearance?: "light" | "dark";
  align?: "center" | "left";
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  appearance = "light",
  align = "center",
  class: className,
} = Astro.props;

const isCentered = align === "center";
const isDark = appearance === "dark";
---

{
  (eyebrow || title || description) && (
    <div
      data-reveal
      class:list={[
        "space-y-5",
        isCentered && "mx-auto max-w-3xl text-center",
        className,
      ]}>
      {eyebrow && (
        <p
          class:list={[
            "font-secondary flex items-center gap-2 text-sm font-semibold tracking-widest uppercase",
            isCentered && "justify-center",
            isDark ? "text-accent-light" : "text-dark",
          ]}>
          <svg
            viewBox="0 0 100 115.47"
            class="fill-accent size-3 shrink-0"
            aria-hidden="true">
            <polygon points="50,0 100,28.87 100,86.6 50,115.47 0,86.6 0,28.87" />
          </svg>
          {eyebrow}
        </p>
      )}
      {title && (
        <h2
          class:list={[
            !eyebrow && "section-title",
            !eyebrow && isCentered && "section-title-center",
            isDark && "text-light",
          ]}
          set:html={markdownify(title)}
        />
      )}
      {description && (
        <p
          class:list={["text-lg opacity-80", isDark && "text-light"]}
          set:html={markdownify(description)}
        />
      )}
    </div>
  )
}
