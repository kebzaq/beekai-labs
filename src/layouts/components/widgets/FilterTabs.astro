---
/**
 * Filter buttons for a list of items, without a page reload.
 *
 * Usage: wrap the tabs and the items in an element with `data-filter-root`.
 * - Items: `data-filter-item` and `data-categories="id-1 id-2"`
 * - Optional groups: `data-filter-group="id"` (the selected tab then shows one whole group)
 * Without JavaScript every item stays visible.
 */
interface Props {
  tabs: { id: string; title: string }[];
  allLabel: string;
  label: string; // Accessible name of the button group
  class?: string;
}

const { tabs, allLabel, label, class: className } = Astro.props;
---

{
  tabs.length > 1 && (
    <div
      role="group"
      aria-label={label}
      class:list={["flex flex-wrap justify-center gap-3", className]}>
      <button
        type="button"
        class="filter-tab"
        aria-pressed="true"
        data-filter="all">
        {allLabel}
      </button>
      {tabs.map((tab) => (
        <button
          type="button"
          class="filter-tab"
          aria-pressed="false"
          data-filter={tab.id}>
          {tab.title}
        </button>
      ))}
    </div>
  )
}

<script>
  document
    .querySelectorAll<HTMLElement>("[data-filter-root]")
    .forEach((root) => {
      const tabs = root.querySelectorAll<HTMLButtonElement>("[data-filter]");
      const groups = root.querySelectorAll<HTMLElement>("[data-filter-group]");
      const items = root.querySelectorAll<HTMLElement>("[data-filter-item]");

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const filter = tab.dataset.filter || "all";

          tabs.forEach((other) =>
            other.setAttribute("aria-pressed", String(other === tab)),
          );

          if (groups.length > 0) {
            // Grouped layout: show one group, or all of them
            groups.forEach((group) => {
              group.hidden =
                filter !== "all" && group.dataset.filterGroup !== filter;
            });
          } else {
            // Flat layout: show the items of the selected category
            items.forEach((item) => {
              const categories = (item.dataset.categories || "").split(" ");
              item.hidden = filter !== "all" && !categories.includes(filter);
            });
          }
        });
      });
    });
</script>
