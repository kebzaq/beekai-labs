---
import Base from "@/layouts/Base.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";
import { getEntryCTM } from "@/lib/contentParser.astro";
import overrideObjects from "@/lib/utils/overrideObjects.ts";
import PageHeader from "@/components/widgets/PageHeader.astro";
import PortfolioSection from "@/components/sections/PortfolioSection.astro";
import CallToAction from "@/components/sections/CallToAction.astro";

export function getStaticPaths() {
  return generatePaths();
}

const page = await getEntryCTM("pages", "portfolio", Astro.currentLocale);
const { title, description, portfolioSection, ctaSection } = page.data;

// Full list: every project, grouped under its category when "All" is selected
const portfolioDefaults = {
  title: "",
  description: "",
  options: { featuredOnly: false, limit: false, grouped: true },
  button: { enable: false },
};
---

<Base {...page.data} headerPosition="fixed" hasHeaderDarkBackground={true}>
  <PageHeader title={title} description={description} />
  <PortfolioSection
    content={overrideObjects(portfolioDefaults, portfolioSection)}
  />
  <CallToAction content={ctaSection} />
</Base>
