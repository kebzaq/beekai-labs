---
import Base from "@/layouts/Base.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";
import { getEntryCTM } from "@/lib/contentParser.astro";
import Banner from "@/components/sections/Banner.astro";
import IndustriesSection from "@/components/sections/IndustriesSection.astro";
import ToolsSection from "@/components/sections/ToolsSection.astro";
import WhyUsSection from "@/components/sections/WhyUsSection.astro";
import IndustryDetailsSection from "@/components/sections/IndustryDetailsSection.astro";
import ServicesSection from "@/components/sections/ServicesSection.astro";
import StatsSection from "@/components/sections/StatsSection.astro";
import PortfolioSection from "@/components/sections/PortfolioSection.astro";
import TestimonialsSection from "@/components/sections/TestimonialsSection.astro";
import ProcessSection from "@/components/sections/ProcessSection.astro";
import ContactSection from "@/components/sections/ContactSection.astro";
import CallToAction from "@/components/sections/CallToAction.astro";

export function getStaticPaths() {
  return generatePaths();
}

const page = await getEntryCTM("homepage", "-index", Astro.currentLocale);
const sections = page?.data as Record<string, any>;
---

<Base {...page?.data} headerPosition="fixed" hasHeaderDarkBackground={true}>
  <Banner content={sections?.bannerAgencySection} />
  <IndustriesSection content={sections?.industriesSection} />
  <ToolsSection content={sections?.toolsSection} />
  <WhyUsSection content={sections?.whyUsSection} />
  <IndustryDetailsSection content={sections?.industryDetailsSection} />
  <ServicesSection content={sections?.servicesSection} />
  <StatsSection content={sections?.statsSection} />
  <PortfolioSection content={sections?.portfolioSection} />
  <TestimonialsSection content={sections?.testimonialsSection} />
  <ProcessSection content={sections?.processSection} />
  <ContactSection content={sections?.contactSection} />
  <CallToAction content={sections?.ctaSection} />
</Base>
