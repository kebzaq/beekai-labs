---
import Base from "@/layouts/Base.astro";
import Icons from "@/helpers/Icons.astro";
import config from ".astro/config.generated.json";
import { generatePaths, useTranslations } from "@/lib/utils/i18nUtils";
import { getCollectionCTM } from "@/lib/contentParser.astro";
import { getIndustries } from "@/lib/utils/siteData";
import CustomButton from "@/components/CustomButton.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import PortfolioCard from "@/components/cards/PortfolioCard.astro";
import ServicesSection from "@/components/sections/ServicesSection.astro";
import CallToAction from "@/components/sections/CallToAction.astro";

// One page per industry in src/content/data/industries.yml
export async function getStaticPaths() {
  const industries = await getIndustries();

  return generatePaths().flatMap(({ params }) =>
    industries.map((industry) => ({
      params: { ...params, slug: industry.id },
      props: { industry },
    })),
  );
}

const { industry } = Astro.props;
const { title, audience, benefit, problems, solutions } = industry.data;

const t = await useTranslations(Astro.currentLocale as string);

// Portfolio projects of this industry
const projects = (
  await getCollectionCTM(
    config.settings.portfolioFolder as "portfolio",
    Astro.currentLocale,
  )
).filter((project) => project.data.industry === industry.id);
---

<Base
  title={title}
  description={benefit}
  headerPosition="fixed"
  hasHeaderDarkBackground={true}>
  <PageHeader eyebrow={audience} title={title} description={benefit}>
    <CustomButton
      label={t("navigation.buttonLabel")}
      url="/contact/"
      hoverEffect="creative-fill"
      class="btn-accent effect-color-light"
    />
  </PageHeader>

  <section>
    <div class="container">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
        <div class="border-border-light space-y-6 border p-8 md:p-10">
          <h2 class="text-h4-sm md:text-h4">{t("common.problemsTitle")}</h2>
          <ul class="space-y-3">
            {
              problems.map((problem) => (
                <li class="flex items-start gap-3">
                  <Icons
                    icon="CircleAlert"
                    class="mt-1 size-5 shrink-0 opacity-60"
                    aria-hidden="true"
                  />
                  <span>{problem}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="bg-theme-light space-y-6 p-8 md:p-10">
          <h2 class="text-h4-sm md:text-h4">{t("common.solutionsTitle")}</h2>
          <ul class="space-y-3">
            {
              solutions.map((solution) => (
                <li class="flex items-start gap-3">
                  <Icons
                    icon="Check"
                    class="text-accent-hover mt-1 size-5 shrink-0"
                    aria-hidden="true"
                  />
                  <span>{solution}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  {
    projects.length > 0 && (
      <section>
        <div class="container space-y-10">
          <h2 class="section-title text-h3-sm md:text-h3">
            {t("common.relatedProjectsTitle")}
          </h2>
          <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
            {projects.map((project) => (
              <PortfolioCard content={project} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <ServicesSection />
  <CallToAction />
</Base>
