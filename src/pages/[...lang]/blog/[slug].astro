---
import { render } from "astro:content";
import Base from "@/layouts/Base.astro";
import config from ".astro/config.generated.json";
import extractSlug from "@/lib/utils/extractSlug";
import { formatPostDate, readingTime } from "@/lib/utils/blogUtils";
import { getCollectionCTM } from "@/lib/contentParser.astro";
import { supportedLanguages, useTranslations } from "@/lib/utils/i18nUtils";
import BlogCard from "@/components/cards/BlogCard.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import CallToAction from "@/components/sections/CallToAction.astro";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";

// One page per post in src/content/blog. Drafts are only built in `npm run dev`.
export async function getStaticPaths() {
  const { defaultLanguage, showDefaultLangInUrl } =
    config.settings.multilingual;

  const paths = await Promise.all(
    supportedLanguages.map(async (lang) => {
      const posts = await getCollectionCTM(
        config.settings.blogFolder as "blog",
        lang.languageCode,
      );

      return posts.map((post) => ({
        params: {
          lang:
            lang.languageCode === defaultLanguage && !showDefaultLangInUrl
              ? undefined
              : lang.languageCode,
          slug: extractSlug(post).split("/").pop(),
        },
        props: {
          post,
          // Up to 3 other posts that share a tag, newest first
          related: posts
            .filter(
              (other) =>
                other.id !== post.id &&
                other.data.tags.some((tag) => post.data.tags.includes(tag)),
            )
            .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
            .slice(0, 3),
        },
      }));
    }),
  );

  return paths.flat();
}

const { post, related } = Astro.props;
const { title, description, date, author, tags, coverImage } = post.data;

const t = await useTranslations(Astro.currentLocale as string);
const { Content } = await render(post);
const minutes = readingTime(post.body);
---

<Base {...post.data} headerPosition="fixed" hasHeaderDarkBackground={true}>
  <PageHeader
    eyebrow={tags.join(" · ")}
    title={title}
    description={description}>
    <p class="text-sm opacity-80">
      {`${t("common.byAuthor")} ${author} · `}
      <time datetime={date.toISOString()}>{formatPostDate(date)}</time>
      {` · ${minutes} ${t("common.minRead")}`}
    </p>
  </PageHeader>

  <section>
    <div class="container">
      <article class="mx-auto max-w-3xl space-y-10">
        {
          coverImage && (
            <OptimizedImage
              src={coverImage}
              alt=""
              width={896}
              height={504}
              loading="eager"
              class="aspect-video w-full object-cover"
            />
          )
        }
        <div class="prose-styles">
          <Content />
        </div>
      </article>
    </div>
  </section>

  {
    related.length > 0 && (
      <section>
        <div class="container space-y-10">
          <h2 class="section-title text-h3-sm md:text-h3">
            {t("common.relatedPostsTitle")}
          </h2>
          <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
            {related.map((item) => (
              <BlogCard content={item} headingTag="h3" />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CallToAction />
</Base>
