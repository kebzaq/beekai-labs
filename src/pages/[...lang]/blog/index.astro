---
import Base from "@/layouts/Base.astro";
import config from ".astro/config.generated.json";
import { tagId } from "@/lib/utils/blogUtils";
import { generatePaths, useTranslations } from "@/lib/utils/i18nUtils";
import { getCollectionCTM, getEntryCTM } from "@/lib/contentParser.astro";
import BlogCard from "@/components/cards/BlogCard.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import FilterTabs from "@/components/widgets/FilterTabs.astro";
import CallToAction from "@/components/sections/CallToAction.astro";

export function getStaticPaths() {
  return generatePaths();
}

const page = await getEntryCTM("pages", "blog", Astro.currentLocale);
const { title, description, ctaSection } = page.data;

const t = await useTranslations(Astro.currentLocale as string);

// Newest first. Posts with `draft: true` are only listed in `npm run dev`.
const posts = (
  await getCollectionCTM(
    config.settings.blogFolder as "blog",
    Astro.currentLocale,
  )
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Tag filter tabs, built from the tags of the listed posts
const tags = [...new Set(posts.flatMap((post) => post.data.tags))]
  .sort()
  .map((tag) => ({ id: tagId(tag), title: tag }));
---

<Base {...page.data} headerPosition="fixed" hasHeaderDarkBackground={true}>
  <PageHeader title={title} description={description} />
  <section id="posts">
    <div class="container space-y-10" data-filter-root>
      {
        posts.length > 0 ? (
          <>
            <FilterTabs
              tabs={tags}
              allLabel={t("common.allLabel")}
              label={t("common.filterPosts")}
            />
            <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
              {posts.map((post) => (
                <BlogCard content={post} />
              ))}
            </div>
          </>
        ) : (
          <p class="text-center text-lg">{t("common.noPosts")}</p>
        )
      }
    </div>
  </section>
  <CallToAction content={ctaSection} />
</Base>
