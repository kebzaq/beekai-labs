---
import Base from "@/layouts/Base.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";
import { getEntryCTM } from "@/lib/contentParser.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import AboutSection from "@/components/sections/AboutSection.astro";
import TeamSection from "@/components/sections/TeamSection.astro";
import StorySection from "@/components/sections/StorySection.astro";
import ValuesSection from "@/components/sections/ValuesSection.astro";
import CallToAction from "@/components/sections/CallToAction.astro";

export function getStaticPaths() {
  return generatePaths();
}

const page = await getEntryCTM("pages", "about", Astro.currentLocale);
const {
  title,
  description,
  storySection,
  aboutSection,
  valuesSection,
  teamSection,
  ctaSection,
} = page.data;
---

<Base {...page.data} headerPosition="fixed" hasHeaderDarkBackground={true}>
  <PageHeader title={title} description={description} />
  <StorySection content={storySection} />
  <AboutSection content={aboutSection} />
  <ValuesSection content={valuesSection} />
  <TeamSection content={teamSection} />
  <CallToAction content={ctaSection} />
</Base>
