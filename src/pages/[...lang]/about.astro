---
import Base from "@/layouts/Base.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";
import { getEntryCTM } from "@/lib/contentParser.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import AboutSection from "@/components/sections/AboutSection.astro";
import TeamSection from "@/components/sections/TeamSection.astro";
import WhyUsSection from "@/components/sections/WhyUsSection.astro";
import CallToAction from "@/components/sections/CallToAction.astro";

export function getStaticPaths() {
  return generatePaths();
}

const page = await getEntryCTM("pages", "about", Astro.currentLocale);
const { title, description, aboutSection, teamSection, whyUsSection, ctaSection } =
  page.data;
---

<Base {...page.data} headerPosition="fixed" hasHeaderDarkBackground={true}>
  <PageHeader title={title} description={description} />
  <AboutSection content={aboutSection} />
  <TeamSection content={teamSection} />
  <WhyUsSection content={whyUsSection} />
  <CallToAction content={ctaSection} />
</Base>
