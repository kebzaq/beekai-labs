---
import Base from "@/layouts/Base.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";
import { getEntryCTM } from "@/lib/contentParser.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import ServiceGroupsSection from "@/components/sections/ServiceGroupsSection.astro";
import ProcessSection from "@/components/sections/ProcessSection.astro";
import CallToAction from "@/components/sections/CallToAction.astro";

export function getStaticPaths() {
  return generatePaths();
}

const page = await getEntryCTM("pages", "services", Astro.currentLocale);
const { title, description, serviceGroupsSection, processSection, ctaSection } =
  page.data;
---

<Base {...page.data} headerPosition="fixed" hasHeaderDarkBackground={true}>
  <PageHeader title={title} description={description} />
  <ServiceGroupsSection content={serviceGroupsSection} />
  <ProcessSection content={processSection} />
  <CallToAction content={ctaSection} />
</Base>
